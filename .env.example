# Copy this file to .env and fill in the values. .env is ignored by git; this example is committed.
# Both connection strings come from the Neon dashboard (Project -> Connect).

# Pooled connection (host contains "-pooler"). The app uses this one.
DATABASE_URL=""

# Direct connection (pooling off, host without "-pooler"). Prisma migrations use this one.
DIRECT_URL=""

# Clerk keys, from the Clerk dashboard (API keys). Both are also needed in Vercel,
# for Production and Preview. The publishable key is safe in the browser; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Stripe, TEST MODE ONLY. The app refuses a live key (lib/stripe.ts). Both are also needed in Vercel,
# for Production and Preview. Neither is ever safe in the browser.
# The test secret key (starts with sk_test_), from the Stripe dashboard in test mode (Developers, API keys).
STRIPE_SECRET_KEY=""
# The signing secret of the webhook endpoint (starts with whsec_). For a deployment: Stripe dashboard,
# Developers, Webhooks, the endpoint for <site>/api/webhooks/stripe. On your own computer: the one
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints.
STRIPE_WEBHOOK_SECRET=""

# Self-serve checkout, TEST MODE ONLY. Leave it empty and nobody is offered a plan picker.
# Set it to "test" to open checkout, paid for with Stripe's public test card: on your own computer, and in
# Vercel for PREVIEW ONLY. It is ignored on Vercel's production deployment whatever it is set to, because a
# test-mode checkout on the live site would let anyone open a clinic for nothing (checkoutIsOpen in lib/stripe.ts).
# Not a secret.
BILLING_CHECKOUT=""

# Optional. Extra web addresses Stripe may send people back to after checkout, comma-separated, https only,
# for instance "https://app.example.com". Vercel's own addresses and localhost are known already
# (lib/trusted-origin.ts), so this is only needed for a custom domain. Not a secret.
APP_ORIGINS=""

# Email, through Resend (lib/email.ts). Both are needed before any email is sent; with either one empty
# the app runs as before, and a patient's request to turn a paused link back on is recorded and listed on
# the clinic's overview instead of being emailed. Both also go in Vercel, for Production and Preview.
# The API key from the Resend dashboard (API Keys). A secret, never safe in the browser.
RESEND_API_KEY=""
# Who the email is from, on a domain verified in Resend (Domains), for instance "Pulse 3D <links@pulse3dmedia.com>".
# Not a secret.
EMAIL_FROM=""
