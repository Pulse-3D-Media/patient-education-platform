    "db:seed-placeholders": "tsx --env-file=.env prisma/seed-placeholders.ts",
    "db:link-clinic": "tsx --env-file=.env prisma/link-clinic.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@prisma/client": "^6.19.3",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
