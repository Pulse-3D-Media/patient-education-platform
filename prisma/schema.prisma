generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DIRECT_URL") // direct connection, used by migrations
}

enum Category {
  SPINE
  COMPLEX_SPINE
  KNEE
  SHOULDER
  HIP
  FOOT_ANKLE
}

/// Pulse 3D's own library. Not owned by any clinic.
model Video {
  id              String   @id @default(cuid())
  title           String // "Total Knee Replacement"
  category        Category
  videoUrl        String // read via getPlaybackUrl(), never directly
  durationSeconds Int?
  isPublished     Boolean  @default(false) // staging: Van finishes animations before they go live
  isPlaceholder   Boolean  @default(false) // a sample animation stands in for this procedure. Shown, but marked everywhere it appears. Not the same as isPublished.
  posterUrl       String? // a still shown on the library card instead of the video's own first frame; empty means the branded fallback
  notes           String? // internal, for Pulse staff on /pulse/videos: what the file is, what is still to do. Never shown to a clinic
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shares          Share[]

  @@index([category])
}

/// One row per library category: whether it is offered for sale, and the
/// sentence the library shows while it has nothing published. Rows are made
/// on first read with the defaults (getCategoryConfigs() in
/// lib/db/category-config.ts), so a category with no row behaves like one
/// that was never touched: for sale, default sentence.
model CategoryConfig {
  category       Category @id
  sellable       Boolean  @default(true) // false takes the category off the price list; it still shows in the library
  comingSoonText String? // shown on the library's "Coming soon" tile while the category has no published video
}

/// Where a clinic stands with us. Only ACTIVE clinics can use the library
/// (see clinicIsOpen() in lib/clinic-status.ts). New clinics start PENDING
/// until they choose a plan; the other states come with billing.
enum ClinicStatus {
  PENDING
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELED
}

/// A customer practice. One row per Clerk organization: the row is created
/// the first time someone from that organization signs in (lib/clinic.ts).
model Clinic {
  id         String       @id @default(cuid())
  name       String // copied from the Clerk organization's name; used for the on-video watermark
  clerkOrgId String?      @unique // the Clerk organization its staff sign in with
  status     ClinicStatus @default(PENDING) // changed by billing, by npm run db:set-status, or by Pulse staff on /pulse
  logoUrl    String? // copied from the Clerk organization's logo, when it has one; Pulse staff can set one too
  createdAt  DateTime     @default(now())

  // Set by Pulse staff on /pulse. Nothing here is shown to the clinic except
  // noticeText (top of its /admin) and the effect of showPlaceholders and
  // viewDaysOverride.
  managedByPulse   Boolean      @default(false) // enterprise or comped: billing screens hidden, plan edited by Pulse
  statusReason     String? // why staff set the status by hand
  statusChangedBy  String? // who last changed the status: a staff name, or "billing" later
  statusChangedAt  DateTime? // when the status was last changed
  notes            String? // the old single notes box. Superseded by ClinicNote (its text was copied over); kept, never read (rule 4)
  noticeText       String? // a line shown at the top of that clinic's /admin
  showPlaceholders Boolean      @default(true) // false hides placeholder videos from this clinic's library
  viewDaysOverride Int? // days a patient link works after the first play, instead of AppSettings.viewDays; copied onto each new link when it is made
  phone            String? // the clinic's phone, stored as digits only; see lib/phone.ts
  categories       Category[]   @default([]) // the categories on the clinic's plan; empty means none yet
  surgeonSeats     Int          @default(0) // surgeon seats the clinic pays for
  // The clinic's own look, on its /admin, /library and patient pages. Set by
  // the clinic's admin on /admin/branding or by Pulse staff on /pulse; the
  // last save wins and every change is logged. Both are checked by
  // lib/branding.ts before they are saved and again when they are read, so a
  // value that is not understood falls back to the Pulse look.
  brandColor       String? // one brand colour as "#rrggbb"; empty means the Pulse teal. The readable shades are worked out from it, never stored
  brandFont        String? // the key of one font from the short list in lib/branding.ts; empty means Inter
  brandTheme       String? // "light" for light staff screens (/library and /admin); empty or "dark" means dark, which is what every clinic had before. Checked by parseBrandTheme in lib/branding.ts. The patient page and /pulse ignore it
  shares           Share[]
  clinicNotes      ClinicNote[]

  // The pricing version this clinic is pinned to, once it has a subscription
  // (billing sets it). Empty means the active version. Activating a new
  // version never changes a pin: a clinic keeps the prices it signed up at.
  pricingVersionId String?
  pricingVersion   PricingVersion? @relation(fields: [pricingVersionId], references: [id], onDelete: Restrict) // a pinned version cannot be deleted; a pin is never silently lost

  // Billing (see lib/billing-state.ts for the rules, lib/db/billing.ts for the writes).
  //
  // `status` above is the clinic's EFFECTIVE status: what the app reads to
  // decide whether the clinic is open. It is never set on its own any more.
  // It is worked out (effectiveAccess in lib/billing-state.ts) from three
  // things that are stored separately, and rewritten whenever one of them
  // changes: what Pulse staff set by hand (staffAccess), whether Pulse
  // manages the clinic (managedByPulse), and what Stripe says about its
  // payments (the ClinicBilling row).
  practiceType PracticeType   @default(UNKNOWN) // a hospital is always Enterprise and never pays by card; set only by Pulse staff. UNKNOWN counts as a clinic (decided 2026-09-25)
  staffAccess  StaffAccess? // what Pulse staff set by hand, which always wins over billing; empty means nothing set by hand (billing decides). Who, why and when are statusChangedBy, statusReason and statusChangedAt
  graceEndsAt  DateTime? // only while status is PAST_DUE: the exact moment the grace period ends and the clinic closes. Copied from ClinicBilling.graceEndsAt; empty with PAST_DUE means closed
  billing      ClinicBilling?
  billingPlans BillingPlan[]

  // Who holds one of the surgeon seats above, and which open invitations hold
  // one (see lib/seats.ts for the rules, lib/db/seats.ts for the writes).
  seatAllocations SeatAllocation[]
  seatInvitations SeatInvitation[]

  // The account owner: the Clerk user id (user_...) of the one person who
  // runs this clinic's account. Always an admin, and the only person who does
  // not need a seat. Set when the clinic is created (the person who created
  // its Clerk organization), moved by the owner's handoff on /admin/people or
  // by Pulse staff on /pulse, and cleared when the seat check finds the owner
  // is no longer in the clinic. Empty for every clinic made before owners
  // existed, and after an owner leaves: /pulse flags it. An id only.
  ownerClerkUserId String?
}

/// Whether Clerk's copy of a seat agrees with ours yet. From the seat model
/// of September 2026 on, a seat no longer depends on anything written to
/// Clerk, so every new seat is SYNCED; PENDING is only found on rows written
/// by the earlier model, and the seat check marks those SYNCED (rule 4 keeps
/// the enum).
enum SeatSyncState {
  PENDING // written by the earlier model while its Clerk label write was on its way
  SYNCED // confirmed
}

/// One surgeon seat, held by one person at one clinic. THIS TABLE IS THE
/// AUTHORITY on who holds a paid seat. The rows here plus the open
/// invitations in SeatInvitation are what is compared with
/// Clinic.surgeonSeats, and a row in either is only ever added inside a
/// transaction that holds the clinic's row lock, so two people reaching for
/// the last seat cannot both get it.
///
/// It holds two ids and nothing about the person: no name, no email, no role.
/// Everyone in the clinic except the account owner needs a seat; a person
/// with no row here is WAITING for one.
model SeatAllocation {
  id          String        @id @default(cuid())
  clinicId    String // the tenant column. Always filter by it.
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clerkUserId String // the Clerk user id (user_...) of the person holding the seat. An id only
  syncState   SeatSyncState @default(PENDING)
  reservedAt  DateTime      @default(now()) // when the seat was given
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([clinicId, clerkUserId]) // one seat per person per clinic, which is also what makes a repeated request harmless
}

/// One seat held by an invitation that has not been accepted yet. It counts
/// against the clinic's seats exactly like a SeatAllocation row, so an admin
/// can only have as many open invitations as there are free seats. Written
/// under the clinic's row lock, like a seat.
///
/// The Clerk invitation carries this row's id in its public metadata
/// ({ seatHold: id }); Clerk copies that onto the person's membership when
/// they accept, and the seat check then turns this hold into their seat. A
/// hold is let go when its invitation is revoked or expires, or when it was
/// reserved and Clerk never made the invitation.
///
/// Ids only: the email the invitation went to lives in Clerk, never here.
model SeatInvitation {
  id                String   @id @default(cuid())
  clinicId          String // the tenant column. Always filter by it.
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clerkInvitationId String?  @unique // Clerk's invitation id (orginv_...), set once Clerk has made the invitation. Empty for a moment while it is being made
  reservedAt        DateTime @default(now()) // when the seat was held. A hold whose invitation Clerk never made is let go after a few minutes
  createdAt         DateTime @default(now())

  @@index([clinicId])
}

/// What kind of practice a clinic is, for billing. Never guessed from a name.
enum PracticeType {
  UNKNOWN // not answered yet. Every clinic starts here, including every clinic that existed before billing
  CLINIC // a clinic or private practice: may pay by card (Solo or Clinic, by seats)
  HOSPITAL // a hospital or health system: always Enterprise, set up by Pulse, never self-serve
}

/// What Pulse staff set by hand about a clinic's access. It always wins over
/// what billing says: a payment arriving never reopens a clinic staff paused,
/// and a failed payment never closes a clinic staff are holding open.
enum StaffAccess {
  OPEN // opened by hand (how every clinic was switched on before billing)
  PAUSED // closed by hand, for now
  CANCELED // closed by hand, ended
}

/// Where a clinic's card subscription stands, as Stripe reports it, reduced to
/// the states the product needs. This is the financial record only; whether
/// the clinic is open is Clinic.status.
enum BillingStatus {
  NONE // no subscription (never had one, or the first payment was never completed)
  INCOMPLETE // checkout was started; the first payment is not confirmed. No access comes from this
  ACTIVE // paid and in good standing
  PAST_DUE // a renewal payment failed. The grace period runs from the first time this was recorded
  CANCELED // the subscription has ended
}

/// How often a plan is charged.
enum BillingInterval {
  MONTH
  YEAR
}

/// Stripe's side of one clinic: the customer, the ONE subscription the clinic
/// is expected to have, and where that subscription stands. One row per
/// clinic, made when the clinic first starts a checkout. Written only by
/// lib/db/billing.ts, inside a transaction that holds the clinic's row lock.
model ClinicBilling {
  clinicId             String        @id
  clinic               Clinic        @relation(fields: [clinicId], references: [id])
  stripeCustomerId     String?       @unique // set once, before a checkout is started; never changed
  stripeSubscriptionId String?       @unique // the subscription this clinic is expected to have. News about any other subscription is ignored
  status               BillingStatus @default(NONE)
  currentPeriodEnd     DateTime? // when the period the clinic has paid for ends
  cancelAt             DateTime? // set while a cancellation is scheduled: the subscription stays active until then
  paymentFailedAt      DateTime? // when the failed renewal was first recorded. Set once; repeated failures do not move it
  graceEndsAt          DateTime? // paymentFailedAt plus the grace days in the settings at that moment. Fixed once; cleared when payment recovers
  lastReconciledAt     DateTime? // the last time this row was compared with Stripe

  // The plan the clinic agreed to. Plans are rows of their own that are never
  // edited (BillingPlan); these three only point at them.
  pendingPlanId     String?      @unique // accepted at checkout, waiting for the first payment
  pendingPlan       BillingPlan? @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: Restrict)
  currentPlanId     String?      @unique // in force
  currentPlan       BillingPlan? @relation("CurrentPlan", fields: [currentPlanId], references: [id], onDelete: Restrict)
  scheduledPlanId   String?      @unique // takes over at scheduledChangeAt (a seat reduction at renewal, for instance). Nothing sets it until plan changes are built
  scheduledPlan     BillingPlan? @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: Restrict)
  scheduledChangeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One plan a clinic accepted: what it chose, what that includes, the pricing
/// version it was quoted from and the exact amounts. Written once and never
/// edited, so what a clinic agreed to can always be shown as it was.
model BillingPlan {
  id                 String          @id @default(cuid())
  clinicId           String
  clinic             Clinic          @relation(fields: [clinicId], references: [id])
  pricingVersionId   String
  pricingVersion     PricingVersion  @relation(fields: [pricingVersionId], references: [id], onDelete: Restrict)
  categories         Category[] // what the clinic picked
  entitledCategories Category[] // what it gets, which is every category when the full library is included
  surgeonSeats       Int
  interval           BillingInterval
  perSeatCents       Int // the per-seat amount for the interval, from the pricing engine: the unit price Stripe is given
  totalCents         Int // perSeatCents times the seats
  acceptedById       String // the Clerk user id of the admin who accepted it
  acceptedByName     String
  createdAt          DateTime        @default(now())

  pendingFor   ClinicBilling? @relation("PendingPlan")
  currentFor   ClinicBilling? @relation("CurrentPlan")
  scheduledFor ClinicBilling? @relation("ScheduledPlan")

  @@index([clinicId, createdAt])
}

/// What happened to one notification from Stripe.
enum BillingEventStatus {
  RECEIVED // written down, work not finished (or the process died partway). Tried again when Stripe sends it again, or from /pulse/billing
  PROCESSED // the work was done and committed
  IGNORED // nothing to do, on purpose: not our customer, not the expected subscription, a kind we do not use
  FAILED // the work threw. Stripe was told to send it again
}

/// One row per Stripe event id, which is what makes a repeated delivery
/// harmless: the unique constraint lets one insert through and the rest find
/// the row already there. The body Stripe sent is never stored, only which
/// customer and subscription it was about, so it can be tried again by
/// asking Stripe for the current state.
model BillingEvent {
  id                   String             @id @default(cuid())
  stripeEventId        String             @unique
  type                 String // Stripe's event type, e.g. invoice.paid
  clinicId             String? // the clinic it turned out to be about, when one was found. Not a relation: an event can arrive for a customer we do not know
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               BillingEventStatus @default(RECEIVED)
  outcome              String? // one plain sentence: what was done, or why nothing was
  attempts             Int                @default(0)
  lastErrorCode        String? // the kind of error only (a class name or a code), never a message that could carry a secret
  receivedAt           DateTime           @default(now())
  processedAt          DateTime?

  @@index([status, receivedAt])
  @@index([clinicId, receivedAt])
}

/// One saved set of prices (see lib/pricing.ts for the shape). Versions are
/// only ever added: a config is never edited after it is saved, so a clinic
/// pinned to version 3 keeps exactly the prices version 3 held. At most one
/// version is active, and it is what new quotes use.
model PricingVersion {
  id            String        @id @default(cuid())
  version       Int           @unique @default(autoincrement()) // 1, 2, 3, handed out by the database, so two saves at once cannot share a number
  config        Json // a PricingConfig, validated before it is saved and again when it is read
  note          String // what changed and why, written by the staff member who saved it
  createdAt     DateTime      @default(now())
  createdBy     String // the Clerk user id of the staff member who saved it
  createdByName String // their name, for the history list
  // true for the active version, null for every other one, never false. The
  // unique constraint is what guarantees a single active version: only one
  // row can hold true, while any number of rows can be empty.
  active        Boolean?      @unique
  clinics       Clinic[]
  billingPlans  BillingPlan[] // the accepted plans that were quoted from this version; one of those keeps it from being deleted
}

/// What kind of entry a clinic note is: typed by a staff member, or written
/// by the app when something changed (any change saved on /pulse today; billing later).
enum NoteKind {
  STAFF // typed by a staff member
  STATUS // written by the app when a change was saved on /pulse: status, plan, details, managed by Pulse. Named for the first such change; shown as "Change"
}

/// The running log on a clinic's /pulse page. Append-only: entries are never
/// edited or deleted, so it reads as a history. Internal, never shown to
/// the clinic.
model ClinicNote {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  kind       NoteKind @default(STAFF)
  body       String
  authorName String // the staff member's name, or "billing" and the like for app-written entries
  createdAt  DateTime @default(now())

  @@index([clinicId, createdAt])
}

/// Platform-wide settings. Exactly one row, with id "default". Read through
/// getSettings() in lib/db/settings.ts, which returns these defaults when the
/// row does not exist yet, so nothing depends on it having been created.
model AppSettings {
  id            String   @id @default("default")
  unclaimedDays Int      @default(90) // days a patient link works if nobody ever plays it
  viewDays      Int      @default(7) // days a patient link keeps working after the first play; copied onto each new link as Share.daysAfterFirstPlay
  graceDays     Int      @default(14) // days a clinic keeps access after a missed payment
  qrDailyFlag   Int      @default(200) // scans of one QR code in a day that get flagged for a look
  updatedAt     DateTime @updatedAt
}

/// How a share link's expiry date is worked out (see lib/expiry.ts).
///   FIXED       the Phase 1 rule: expiresAt was set when the link was made
///               and never moves, played or not. Every link made before the
///               first-play rule shipped is FIXED, and so is any link an
///               older copy of the app makes, because FIXED is the database
///               default. Their dates are never changed.
///   FIRST_PLAY  the rule from September 2026 on: the link stops after
///               unclaimedDays if nobody plays it, and the first real play
///               moves expiresAt to that moment plus daysAfterFirstPlay.
enum ExpiryPolicy {
  FIXED
  FIRST_PLAY
}

model Share {
  id           String    @id @default(cuid())
  code         String    @unique // short random string in the URL, e.g. k7m2xq
  clinicId     String // the tenant column. Always filter by it.
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  videoId      String
  video        Video     @relation(fields: [videoId], references: [id])
  expiresAt    DateTime // when the link stops working. Under FIRST_PLAY it moves once, at the first play
  createdAt    DateTime  @default(now())
  viewCount    Int       @default(0) // play starts on the patient page: one per page load, the first time the video actually plays
  lastViewedAt DateTime?

  // The expiry rule this link was made under, and what it needs (see the enum above).
  expiryPolicy       ExpiryPolicy @default(FIXED) // FIXED by default so a link written without it (older code, a hand insert) is a legacy link
  firstPlayedAt      DateTime? // set once, by the first real play of a FIRST_PLAY link; the deadline moved at that moment and never again
  daysAfterFirstPlay Int? // copied from the settings (the clinic's override, else the platform's viewDays) when the link was made, so a later settings edit never changes a link already issued

  @@index([clinicId])
}
